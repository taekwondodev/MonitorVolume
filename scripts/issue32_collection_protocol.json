  },
  "equivalence": {
    "comparisonUnit": "same round workload instrumentation phase and metric",
    "lowerIsBetterMetrics": [
      "bridgeRoundTripNanoseconds",
      "consumerDrainDelayNanoseconds",
      "cpuIntervalPercentOneCore",
      "residentSizeBytes"
    ],
    "bootstrapResamples": 10000,
    "bootstrapSeed": 320032,
    "confidenceInterval": 0.95,
    "centerStatistic": "medianOfPairedBMinusADifferences",
    "minimumSuccessiveDifferencesPerCandidateConfiguration": 19,
    "repeatabilityNoiseBand": "maximum candidate median absolute difference between the 19 successive valid same-configuration run summaries",
    "equivalent": "the full bootstrap confidence interval lies inside plus-or-minus the repeatability noise band",
    "candidateBBetter": "the bootstrap confidence interval upper bound is below the negative repeatability noise band",
    "candidateABetter": "the bootstrap confidence interval lower bound is above the positive repeatability noise band",
    "otherwise": "inconclusive",
    "normalAndStressReportedSeparately": true,
    "noFixedLatencySlaOrInventedPracticalMargin": true
