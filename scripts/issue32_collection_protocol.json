    "requireOneExecutableSha256PerCandidateAcrossAllRuns": true
  },
  "gate": {
    "capacity": 8,
    "phaseDurationMilliseconds": 40,
    "pollIntervalMilliseconds": 10,
    "clockSource": "parentObservedPythonMonotonicNanoseconds",
    "cpuSource": "procPidRusageV0CumulativeCpuTimeDeltaOverParentMonotonicInterval",
    "rssSource": "procPidRusageV0ResidentSizeBytes",
    "missingDataPolicy": "retainFailedAndCensored;excludeFromNumericSummary",
    "candidateProcessTimeoutSeconds": 30,
    "terminationGraceSeconds": 2
  },
  "watchdogs": {
    "apparatusInvocationTimeoutSeconds": 90,
    "buildTimeoutSeconds": 300,
    "environmentCommandTimeoutSeconds": 30,
    "environmentProbeBuildTimeoutSeconds": 60
  },
  "instrumentation": {
    "modes": [
      "full",
      "none"
    ],
    "fullAndNoneObservationSemanticsMustMatch": true,
    "noneMustEmitNoDetailedEvents": true
  },
  "workloads": {
    "normal": {
      "phaseOrder": [
        "activeIdle",
        "isolatedInput",
        "repeatedBurst",
        "mixedBurst",
        "delayedConsumer",
        "suspension",
        "sleepWake",
        "cleanup"
      ],
      "repeatedBurstCycles": 4,
      "includesOverflowStress": false
    },
    "stress": {
      "phaseOrder": [
        "activeIdle",
        "isolatedInput",
        "repeatedBurst",
        "mixedBurst",
        "delayedConsumer",
        "overflowStress",
        "suspension",
        "sleepWake",
        "cleanup"
      ],
      "repeatedBurstCycles": 16,
      "includesOverflowStress": true
    }
  },
  "environment": {
    "samePhysicalHost": true,
    "sameOSBuildAndSwiftToolchain": true,
    "powerSource": "ac",
    "lowPowerMode": false,
    "requiredThermalStateAtBlockStartAndEnd": "nominal",
    "powerSourceObservation": "retain and parse /usr/bin/pmset -g batt at every block boundary; require AC Power",
    "lowPowerModeObservation": "retain and parse the AC Power section of /usr/bin/pmset -g custom at every block boundary; require lowpowermode 0",
    "thermalObservation": "record Foundation ProcessInfo.thermalState at every block boundary; require nominal",
    "hostObservation": "retain sw_vers, uname -m, sysctl hw.model, and sysctl hw.logicalcpu before warmup and after the final measured block",
    "preBlockStabilizationMilliseconds": 5000,
    "betweenRunsCooldownMilliseconds": 1000,
    "forbidConcurrentBuildTestAndDeliberateLoad": true,
    "recordLogicalCpuCount": true,
    "recordHostOsToolchainPowerAndThermalMetadata": true,
    "retainEveryObservation": true,
    "forbidAppInstallLaunchPermissionChangesNativeInputAndHardware": true
  },
  "warmup": {
    "runsPerCandidateWorkloadInstrumentation": 1,
    "retainEvidence": true,
    "excludeFromNumericSummariesAndSelection": true,
    "scheduleConditionOrder": [
      "A/full",
      "B/full",
      "A/none",
      "B/none"
    ],
    "workloadOrder": [
      "normal",
      "stress"
    ]
  },
  "measuredCollection": {
    "rounds": 20,
    "minimumValidRunsPerCandidateWorkloadInstrumentation": 20,
    "runsPerCandidateWorkloadInstrumentation": 20,
    "totalMeasuredRuns": 160,
    "workloadOrderByRoundParity": {
      "odd": [
        "normal",
        "stress"
      ],
      "even": [
        "stress",
        "normal"
      ]
