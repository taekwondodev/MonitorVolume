    "candidateAAtMeasurableParity": true,
    "selectA": "every required metric is equivalent or favors A, with no metric favoring B",
    "selectB": "at least one required metric favors B, every other required metric is equivalent or favors B, and lifecycle ownership review has no blocker",
    "inconclusive": "required evidence is missing, a required metric is indeterminate, or required metrics favor different candidates",
