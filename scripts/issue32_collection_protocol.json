  "sampleDefinitions": {
    "run": "one complete validated candidate process report under one workload and instrumentation mode",
    "bridgeRoundTripNanoseconds": "typedBridgeReturned uptime minus its immediately preceding typedBridgeRequested uptime for the same phase and input",
    "consumerDrainDelayNanoseconds": "consumerDrained uptime minus the final typedBridgeReturned uptime in the same input phase",
    "cpuIntervalPercentOneCore": "one hundred times the proc_pid_rusage cumulative user-plus-system CPU delta divided by the parent monotonic wall interval; 100 percent equals one fully utilized logical core",
    "cpuIntervalPercentMachineCapacity": "cpuIntervalPercentOneCore divided by the recorded active logical CPU count",
    "residentSizeBytes": "instantaneous proc_pid_rusage ri_resident_size at a sampled parent timestamp",
    "baselineResidentSizeBytes": "last wholly attributed resident-size sample in activeIdle",
    "retainedResidentSizeBytes": "last wholly attributed resident-size sample in suspension and cleanup, reported separately",
    "phaseAttribution": "a sample timestamp and the full preceding CPU interval must lie within the parent-observed phase range"
  },
  "minimumTimingSamplesPerValidRun": {
    "bridgeRoundTripNanoseconds": {
      "isolatedInput": 2,
      "normalRepeatedBurst": 8,
      "stressRepeatedBurst": 32,
      "mixedBurst": 6
    },
    "consumerDrainDelayNanoseconds": {
      "isolatedInput": 1,
      "repeatedBurst": 1,
      "mixedBurst": 1
    }
  },
  "summaryDefinitions": {
    "timing": [
